NODE_ENV=production
PORT=4310
HOST=127.0.0.1
DATABASE_PATH=/var/lib/acquit/acquit.db
# The private scoping store both units read (A1): approved drafts land here, never in the repo or a
# bundle. The shared resolver's default is the profile config root's private store; this deployment
# pins the directory outright.
ACQUIT_SCOPING_DIR=/var/lib/acquit/scoping
WEB_ORIGIN=https://80-225-220-230.sslip.io
# P1 keeps the VM in dev mode (unsigned replay, seeded sign-in, dev clock) until H2 turns it off.
ACQUIT_DEV=1
# The demo's address allowlist: comma-separated client IP addresses that may start a demo. Unset or empty opens the
# demo to everyone. Set the real value on the VM only, never in this tracked file.
# ACQUIT_DEMO_ALLOW_IPS=
ACQUIT_VERIFIER_CI_URL=http://127.0.0.1:4311
ACQUIT_VERIFIER_CALLBACK_URL=http://127.0.0.1:4310/api/verifier/callback
ACQUIT_VERIFIER_PORT=4311
ACQUIT_VERIFIER_SUBJECT=docker
ACQUIT_VERIFIER_CONCURRENCY=1
VERIFIER_NODE_IMAGE=node:24-bookworm-slim
ACQUIT_RUNNER_IMAGE=acquit/runner-node20
