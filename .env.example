# Acquit configuration. Copy this file to .env, then uncomment only the lines you need.
# Keep unused lines commented. Unset variables fall back to the defaults named below.
# The API and verifier read .env at startup. .env is gitignored. Never commit real values.

# ---- API and web app ----

# Port for the API (default 4310).
# PORT=

# Port for the Vite web dev server (default 5173).
# WEB_PORT=

# Origin the API allows for the web app (default http://localhost:<WEB_PORT>).
# WEB_ORIGIN=

# SQLite database file (default ./data/acquit.db).
# DATABASE_PATH=

# Set to 1 for local development only. Enables dev-only behavior, such as the example fixture registry and the child verifier subject. Leave unset on a public server.
# ACQUIT_DEV=

# Fixture registry JSON file. Required when ACQUIT_DEV is not 1.
# ACQUIT_FIXTURES=

# Fixture that the guided scenarios use (default maya-client/invoice-app#12).
# ACQUIT_SCENARIO_FIXTURE=

# Client repository as owner/repo (default: the demo repository).
# ACQUIT_CLIENT_REPOSITORY=

# Comma-separated IP addresses allowed to use the hosted demo. Unset means open to all.
# ACQUIT_DEMO_ALLOW_IPS=

# Directory for scoping case files. It must sit outside every git repository.
# ACQUIT_SCOPING_DIR=

# Credential for the platform role. Keep it private.
# ACQUIT_PLATFORM_KEY=

# PayPal merchant ID of the demo seller. Without it, POST /api/demo returns 503.
# OPERATOR_DEVON_MERCHANT_ID=

# PayPal merchant ID of the House operator. It must differ from the demo seller. Needed when HOUSE_PAYPAL credentials are set.
# OPERATOR_HOUSE_MERCHANT_ID=

# ---- AI models and House delivery ----

# Model provider for Ask and scoping: fireworks (default), droid, or openrouter. Any other value fails at startup.
# ACQUIT_MODEL_PROVIDER=

# Provider for the House coding agent alone: fireworks, droid, or openrouter. Unset, the House follows ACQUIT_MODEL_PROVIDER when that is set, else uses Fireworks when FIREWORKS_API_KEY is set, else droid.
# ACQUIT_HOUSE_PROVIDER=

# Fireworks API key for the fireworks provider (the default). Read by the API only, never by the verifier.
# FIREWORKS_API_KEY=

# Ask and scoping models (fireworks provider). Defaults: Ask accounts/fireworks/models/glm-5p3-flash, fallback accounts/fireworks/models/kimi-k3p1-pro; scoping accounts/fireworks/models/kimi-k3p1-pro, fallback accounts/fireworks/models/glm-5p3.
# ACQUIT_LLM_ASK_MODEL=
# ACQUIT_LLM_ASK_FALLBACK_MODEL=
# ACQUIT_LLM_SCOPING_MODEL=
# ACQUIT_LLM_SCOPING_FALLBACK_MODEL=

# One model attempt's time limit in milliseconds, 1000 to 300000 (default 60000).
# ACQUIT_LLM_TIMEOUT_MS=

# Factory API key for the droid provider (the House, and Ask and scoping when droid is named). On a laptop, the key file ~/.config/acquit/factory-api-key also works.
# FACTORY_API_KEY=

# OpenRouter API base URL (default https://openrouter.ai/api/v1). The OpenRouter key is read from the OS keyring, not from this file.
# OPENROUTER_API_BASE=

# Command the House runner executes instead of the model. When set, it overrides model mode.
# ACQUIT_HOUSE_COMMAND=

# ---- PayPal ----

# PayPal REST API base (default https://api-m.sandbox.paypal.com). The API accepts sandbox URLs only.
# PAYPAL_API_BASE=

# PayPal REST app client ID.
# PAYPAL_CLIENT_ID=

# PayPal REST app client secret. Keep it private.
# PAYPAL_CLIENT_SECRET=

# Webhook ID used to verify PayPal webhook signatures (optional).
# PAYPAL_WEBHOOK_ID=

# Partner merchant ID (optional).
# PAYPAL_PARTNER_MERCHANT_ID=

# Partner attribution ID sent with PayPal calls (optional).
# PAYPAL_PARTNER_ATTRIBUTION_ID=

# Client ID of the House operator's PayPal app. Set both HOUSE_PAYPAL values or neither.
# HOUSE_PAYPAL_CLIENT_ID=

# Client secret of the House operator's PayPal app. Keep it private.
# HOUSE_PAYPAL_CLIENT_SECRET=

# ---- GitHub App ----

# GitHub App ID.
# ACQUIT_GITHUB_APP_ID=

# GitHub App private key in PEM form. Keep it private.
# ACQUIT_GITHUB_APP_PRIVATE_KEY=

# Organization where the GitHub App is installed.
# ACQUIT_GITHUB_APP_ORG=

# GitHub API base URL (default https://api.github.com).
# ACQUIT_GITHUB_API_BASE=

# ---- Verifier ----

# Verifier base URL the API calls. Leave unset to run without a verifier.
# ACQUIT_VERIFIER_CI_URL=

# Shared secret the API uses to start verifier runs. Keep it private.
# ACQUIT_VERIFIER_RUN_SECRET=

# Shared secret the verifier uses for its callbacks. Keep it private.
# ACQUIT_VERIFIER_CALLBACK_SECRET=

# API URL the verifier calls back, for example http://127.0.0.1:4310/api/verifier/callback.
# ACQUIT_VERIFIER_CALLBACK_URL=

# Verifier port (default: API port + 1).
# ACQUIT_VERIFIER_PORT=

# Verifier runs at once, from 1 to 8 (default 2).
# ACQUIT_VERIFIER_CONCURRENCY=

# Time limit for one verifier run, in milliseconds (default 120000).
# ACQUIT_VERIFIER_RUN_DEADLINE_MS=

# What the verifier tests: docker (default) or child (local development only, needs ACQUIT_DEV=1).
# ACQUIT_VERIFIER_SUBJECT=

# Docker image for the runner (default acquit/runner-node20).
# ACQUIT_RUNNER_IMAGE=

# Docker image for the runner's egress proxy (default: ACQUIT_RUNNER_IMAGE).
# ACQUIT_RUNNER_PROXY_IMAGE=

# Docker image the verifier runs fixtures in (default node:24-bookworm-slim).
# VERIFIER_NODE_IMAGE=

# ---- CLI, MCP server, and runner ----

# API address the CLI and MCP server call (default http://127.0.0.1:4310).
# ACQUIT_API=

# Session token for the CLI and MCP server. Keep it private.
# ACQUIT_TOKEN=

# Path to the CLI login file.
# ACQUIT_CLI_CONFIG=

# Model provider for acquit run: anthropic (default) or openrouter.
# ACQUIT_PROVIDER=

# Model name for acquit run.
# ACQUIT_PROVIDER_MODEL=

# Provider API key for acquit run. Keep it private.
# ACQUIT_PROVIDER_KEY=

# Folder where MCP confirmation requests are kept.
# ACQUIT_MCP_CONFIRMATIONS=

# Seconds the MCP server waits for a confirmation (default 120).
# ACQUIT_MCP_CONFIRM_TIMEOUT_SECONDS=

# Seconds the MCP server waits for a submit (default 600).
# ACQUIT_MCP_SUBMIT_TIMEOUT_SECONDS=

# MCP payout-status reader: sandbox (default) or live. live reads real PayPal data, so leave it unset unless you mean it.
# PAYPAL_ENV=

# Port for the runner's egress proxy (default 8888).
# ACQUIT_PROXY_PORT=

# ---- Operator and verification scripts (not read by the app itself) ----

# API address for the web dev proxy and the smoke script (default http://localhost:4310).
# ACQUIT_API_URL=

# Lane number for the control CLI and verification helpers. Each lane has its own database.
# ACQUIT_LANE=

# Account that owns lane test repositories.
# ACQUIT_LANE_REPO_OWNER=

# Git token for lane repositories. Prefer the token file below. Keep it private.
# ACQUIT_LANE_GIT_TOKEN=

# File that holds the lane git token, used as the askpass source.
# ACQUIT_LANE_ASKPASS_TOKEN_FILE=

# Most lanes that can start at once (lanes script).
# ACQUIT_MAX_LANES=

# Most browser sessions at once (default 2).
# ACQUIT_MAX_BROWSERS=

# Memory in MB kept free when starting lanes. Overrides the measured reserve.
# ACQUIT_RESERVE_MB=

# Folder for verification evidence.
# ACQUIT_EVIDENCE_DIR=

# Folder for performance evidence.
# ACQUIT_PERF_EVIDENCE_DIR=

# Path to the invoice-app fixture repository used by the perf and verifier scripts.
# ACQUIT_VERIFIER_FIXTURE=

# Escrow funding mode for the escrow helper: card or checkout (default checkout).
# ACQUIT_FUND_MODE=

# PayPal sandbox buyer login email for the escrow approval helper.
# SANDBOX_BUYER_EMAIL=

# PayPal sandbox buyer password for the escrow approval helper. Keep it private.
# SANDBOX_BUYER_PASSWORD=

# agent-browser dashboard port that the approval helper checks. On Linux, set it empty (naming a port is refused) only after you confirm no other dashboard runs.
# AGENT_BROWSER_DASHBOARD_PORT=

# Folder for agent-browser runtime sockets.
# AGENT_BROWSER_SOCKET_DIR=

# ---- Operating system paths (optional) ----

# Config folder override on Linux and macOS.
# XDG_CONFIG_HOME=

# State folder override on Linux and macOS.
# XDG_STATE_HOME=

# Runtime folder for browser helper sockets on Linux.
# XDG_RUNTIME_DIR=

# Windows config and state folders. Windows sets them; the CLI and scripts read them.
# APPDATA=
# LOCALAPPDATA=

# ---- Web build ----

# AG Grid license key used when the web app is built.
# VITE_AG_STUDIO_LICENSE_KEY=

# ---- Tests only ----

# Set to 1 to run the live Docker tests.
# ACQUIT_DOCKER_TEST=

# Path to a PrusaSlicer binary for the slicer tests.
# ACQUIT_PRUSA=

# ---- Set by Acquit's own tools at run time. Do not set these yourself. ----

# Process ownership record, role, and socket that the control CLI uses to track its child processes.
# ACQUIT_OWNERSHIP_RECORD=
# ACQUIT_OWNERSHIP_ROLE=
# ACQUIT_OWNERSHIP_SOCKET=

# Runner inputs set by the acquit CLI: the instruction text, the working folder, and the provider hosts the egress proxy allows.
# ACQUIT_INSTRUCTION=
# ACQUIT_WORKDIR=
# ACQUIT_PROVIDER_HOST=
