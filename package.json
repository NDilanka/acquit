{
  "name": "acquit",
  "private": true,
  "type": "module",
  "workspaces": ["packages/core", "packages/verifier", "packages/acquit-cli"],
  "scripts": {
    "postinstall": "node scripts/install-web.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node apps/api/src/server.ts",
    "seed": "node scripts/seed.ts",
    "ctl": "node packages/ctl/src/main.ts",
    "test": "node --test --test-timeout=60000 --test-concurrency=1 packages/core/test/*.test.ts packages/ctl/test/*.test.ts",
    "typecheck": "tsc -p . --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=24.0.0" }
}
